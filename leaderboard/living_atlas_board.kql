// THE LIVING ATLAS LEADERBOARD — the live board, Season 1.
//
// This is the whole scoreboard. There is nothing else behind it. Everyone
// in the workspace has Reader access, so don't trust the board — run it.
//
// Season 1 ranks by best score on the open probe. The Polyglot Poisoning
// Hunter badge is an accepted submission at or above the probe's own
// block threshold, which is what the predicate below checks. The badge
// recognizes signal stacking and participation; it does NOT certify that a
// model was bypassed, that a prompt is harmful, or anyone's skill in a
// language.
//
// Leaderboard rows always end in @lb. Planted CTF rows never do, and CTF
// queries should exclude @lb explicitly.
//
// A known weakness, recorded rather than hidden: ranking by score rewards
// stacking, and the most instructive prompt in the pilot scored zero. See
// ../proposals/season-2/ for a contribution-based alternative that is not
// running.

PolyglotPoisoning_CL
| where UserPrincipal endswith "@lb"
| extend Handle = tostring(split(UserPrincipal, "@")[0])
| summarize Best      = max(RiskScore),
            Runs      = count(),
            Languages = dcount(Language),
            FirstSeen = min(TimeGenerated),
            LastSeen  = max(TimeGenerated)
    by Handle
| extend Stage = case(Best >= 5, "RUBEDO",
                      Best >= 4, "CITRINITAS",
                      Best >= 2, "ALBEDO",
                                 "NIGREDO")
| extend Badge = iff(Best >= 5, "Polyglot Poisoning Hunter", "")
| project Handle, Best, Stage, Runs, Languages, Badge, FirstSeen
| sort by Best desc, Runs desc, FirstSeen asc
| take 25

// NOTE ON THE TIEBREAK. This query breaks ties by earliest FIRST
// submission, which is "who got there first". An older version sorted by
// LastSeen, which rewards the handle whose most recent submission is
// earliest — a different rule. If you change the rule, change this file
// and the documentation together: never describe a rule you are not running.

// ---------------------------------------------------------------
// Your own rows:
//
// PolyglotPoisoning_CL
// | where UserPrincipal == "YOUR_HANDLE@lb"
// | project TimeGenerated, Language, Variant, RiskScore, Patterns
// | sort by TimeGenerated desc
//
// Which languages Season 1 is still missing:
//
// PolyglotPoisoning_CL
// | where UserPrincipal endswith "@lb"
// | summarize Rows = count(), Handles = dcount(UserPrincipal) by Language
// | sort by Rows asc
// ---------------------------------------------------------------
